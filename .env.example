# Copy to .env.local for local work; set the same names in Vercel > Settings > Environment Variables.

# Signs the admin session cookie. Generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Admin sign-in. Hash a password with:  node scripts/hash-password.mjs "your password"
ADMIN_EMAIL=admin@example.com
# bcrypt hash. In .env files escape each $ as \$ (the script prints that form); in Vercel paste it unescaped.
ADMIN_PASSWORD_HASH=

# Live domain, used for canonical/OG URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Edit site (Tina, self-hosted). Needed on Vercel only; local `npm run dev` uses local mode and needs none of these. ──
# Upstash Redis (Vercel Marketplace > Upstash for Redis). Vercel injects these names itself.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# GitHub fine-grained token with "Contents: Read and write" on the repo. Publishing commits content/site/home.json with it,
# and photo uploads/deletes in the editor commit to public/img with it (no new variable needed).
GITHUB_PAT=
# Optional. Defaults: Rothenhall / palmregal / the branch Vercel is building (VERCEL_GIT_COMMIT_REF), else main.
GITHUB_OWNER=Rothenhall
GITHUB_REPO=palmregal
GITHUB_BRANCH=

# ── Chatbot (guest AI concierge) ──
# Sarvam AI key (https://dashboard.sarvam.ai). Server only.
SARVAM_API_KEY=
# Optional. Default sarvam-105b-conversations (fast, no hidden reasoning). sarvam-105b also works.
SARVAM_CHAT_MODEL=
# Optional. Signs visitor cookies and hashes IPs. Falls back to AUTH_SECRET.
CHAT_SECRET=
# Optional. Namespace for chat data in Redis. Default: prod: on Vercel production, dev: elsewhere.
CHAT_KEY_PREFIX=
# (uses the same KV_REST_API_URL / KV_REST_API_TOKEN as above)
